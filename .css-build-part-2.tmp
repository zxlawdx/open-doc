/* A document library, with restrained desktop density. */
.open-doc .home {
    flex: 1;
    min-height: 0;
    overflow: auto;
    background: var(--color-workspace);
}
.open-doc .home-inner {
    width: min(calc(100% - 48px), var(--home-max-width));
    margin: 0 auto;
    padding: var(--space-12) 0;
}
.open-doc .home-product {
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: .16em;
    color: var(--color-primary);
    margin: 0 0 var(--space-3);
}
.open-doc .home h1 {
    font-size: var(--font-size-3xl);
    letter-spacing: -.035em;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 var(--space-3);
}
.open-doc .home-intro {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin: 0 0 var(--space-6);
}
.open-doc .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-12);
}
.open-doc .home-actions button {
    border: 1px solid var(--color-border);
    background: var(--color-panel);
    min-height: var(--control-height-lg);
    padding: var(--space-2) var(--space-4);
}
.open-doc .home-actions .primary-button {
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
}
.open-doc .recent-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-3);
}
.open-doc .recent-heading h2 {
    font-weight: 500;
    font-size: var(--font-size-lg);
    margin: 0;
}
.open-doc .recent-heading span {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
}

/* Desktop library follows familiar navigation/content separation. */
.open-doc .home{display:grid;grid-template-columns:220px minmax(0,1fr);align-items:start}
.open-doc .home-side-nav{
  grid-column:1;grid-row:1;position:sticky;top:0;align-self:start;
  display:flex;flex-direction:column;gap:7px;
  height:100%;max-height:calc(100vh - 110px);overflow-y:auto;box-sizing:border-box;
  padding:26px 14px;background:var(--color-panel);
  border-right:1px solid var(--color-border-soft);
}
.open-doc .home-side-nav-title{
  margin:4px 9px 10px;font-size:10px;font-weight:700;
  letter-spacing:.09em;color:var(--color-text-secondary)
}
.open-doc .home-side-nav button{
  display:flex;align-items:center;gap:13px;min-height:43px;
  text-align:left;color:var(--color-text-primary);
  border:1px solid transparent;border-radius:11px;background:transparent;
  padding:10px 12px;font-size:13px;line-height:1.35;
  cursor:pointer
}
.open-doc .home-side-nav button:hover,
.open-doc .home-side-nav button:focus-visible{
  border-color:var(--color-border);background:var(--of-surface-low)
}
.open-doc .home-side-nav button[aria-current=page]{
  background:var(--color-primary-soft);color:var(--color-primary);font-weight:650
}
.open-doc .home-side-nav svg{display:block;flex:0 0 19px;width:19px;height:19px;stroke:currentColor;fill:none}
.open-doc .home-side-divider{border-top:1px solid var(--color-border-soft);margin:9px 7px}
.open-doc .home-inner{grid-column:2;grid-row:1;max-width:min(calc(100% - 48px),var(--home-max-width))}

/* Qt/Chromium 83: explicitly honor hidden after desktop home becomes grid. */
.open-doc .home[hidden]{display:none!important}

/* Icon / flexible title / secondary metadata / reserved action target. */
.open-doc .document-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
}
.open-doc .library-row {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto 32px;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-3) var(--space-1);
    border-bottom: 1px solid var(--color-border-soft);
}
.open-doc .library-file-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 36px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-size: var(--font-size-2xs);
}
.open-doc .library-file-main {
    min-width: 0;
}
.open-doc .library-file-title {
    display: block;
    width: 100%;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0;
    font-size: var(--font-size-md);
}
.open-doc .library-file-meta {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: var(--space-0-5);
}
.open-doc .library-file-kind {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    white-space: nowrap;
}
.open-doc .library-file-actions {
    position: relative;
    width: 32px;
}
.open-doc .library-file-actions > summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--control-icon-width);
    height: var(--control-height-md);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    list-style: none;
    font-size: var(--font-size-2xl);
}
.open-doc .library-file-actions > summary::-webkit-details-marker {
    display: none;
}
.open-doc .document-action-menu {
    min-width: 156px;
}
.open-doc .library-empty {
    color: var(--color-text-secondary);
    padding: var(--space-6) var(--space-1);
    font-size: var(--font-size-md);
}

/* Page position and zoom stay visible; secondary metadata yields first. */
.open-doc .statusbar {
    height: var(--statusbar-height);
    min-height: var(--statusbar-height);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-2);
    font-size: var(--font-size-xs);
    background: var(--color-app-chrome);
    color: var(--color-text-secondary);
    white-space: nowrap;
}
.open-doc .status-left,
.open-doc .status-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    flex-shrink: 0;
}
.open-doc .statusbar button {
    min-height: 22px;
    height: 22px;
    min-width: 23px;
    padding: 0 var(--space-1);
}
.open-doc .statusbar svg {
    width: 14px;
    height: 14px;
}
.open-doc .status-divider {
    height: 11px;
    border-left: 1px solid var(--color-border);
}
.open-doc .status-spacer {
    flex: 1;
    min-width: 0;
}
.open-doc [data-zoom] {
    width: 92px;
    min-width: 54px;
    height: 14px;
    accent-color: var(--color-primary);
}
.open-doc [data-zoom-value] {
    width: 36px;
    text-align: right;
    font-variant-numeric: tabular-nums;
}

/* Shared ink stays outside editable text and scales with each page. */
.ink-toolbar,.fixed-controls{display:flex;align-items:center;flex-wrap:wrap;gap:6px;padding:6px 12px;background:var(--color-panel);border-bottom:1px solid var(--color-border)}
.ink-toolbar button,.fixed-controls button,.fixed-sidebar button{padding:5px 8px;border-radius:4px;color:var(--color-text-primary);background:var(--color-panel);border:1px solid var(--color-border)}
.open-doc .ink-toolbar button[aria-pressed=true]:not(:disabled){background:var(--color-primary);color:var(--color-on-primary)}
.ink-toolbar input[type=number]{width:58px}.ink-toolbar input[type=color]{width:30px;height:28px;padding:0}
.document-page,.fixed-surface{position:relative}.open-doc .ink-overlay{position:absolute;inset:0;width:100%;height:100%;z-index:8;touch-action:none;overflow:hidden}
.fixed-document{flex:1;min-height:0;display:grid;grid-template-columns:170px minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);overflow:hidden;background:var(--color-workspace)}
.fixed-document[hidden], [data-home-view=true] .fixed-document{display:none!important}.fixed-controls{grid-column:1/-1}.fixed-controls input[type=number]{width:60px}.fixed-controls input[type=search]{max-width:220px}
.fixed-sidebar{overflow:auto;padding:8px;display:flex;flex-direction:column;gap:6px;border-right:1px solid var(--color-border);background:var(--color-panel)}
.fixed-scroll{overflow:auto;padding:24px;min-height:0}.fixed-surface{background:white;color:black;box-shadow:0 2px 8px #0003;margin:0 auto 24px;flex:none;overflow:hidden}.fixed-surface>canvas{position:absolute;inset:0}
.fixed-text-overlay{position:absolute;white-space:pre-wrap;line-height:1.25;z-index:7}.pdf-links{position:absolute;inset:0;pointer-events:none;z-index:4}.pdf-links a{position:absolute;pointer-events:auto}
.textLayer,.textLayer *{user-select:text;-webkit-user-select:text}
.textLayer{--scale-factor:1;position:absolute;inset:0;overflow:hidden;opacity:1;line-height:1;text-size-adjust:none;forced-color-adjust:none;transform-origin:0 0;z-index:3}
.textLayer span,.textLayer br{color:transparent;position:absolute;white-space:pre;cursor:text;transform-origin:0% 0%}.textLayer> :not(.markedContent),.textLayer .markedContent span:not(.markedContent){z-index:1}.textLayer span.markedContent{top:0;height:0}.textLayer ::selection{background:#247bdf55;color:transparent}
[data-document-kind=fixed] [data-document-body]{display:none!important}[data-document-kind=fixed] .toolbar{display:none}.dialog textarea{width:100%;min-height:140px;color:var(--color-text-primary);background:var(--color-panel);border:1px solid var(--color-border)}
.fixed-sidebar canvas{display:block;margin:0 auto 4px;max-width:100%;height:auto}.fixed-sidebar [data-thumbnail-index]{min-height:90px}
[data-home-view=true] .ink-toolbar{display:none}
 .fixed-sidebar button{flex-shrink:0}
.fixed-page-error,.fixed-load-error{position:relative;z-index:10;margin:12px;padding:8px;color:var(--color-danger);background:var(--color-panel);border:1px solid var(--color-border)}
.pptx-content{position:absolute;inset:0;overflow:hidden;z-index:1}.open-doc .pptx-content>svg{width:100%;height:100%;display:block}.open-doc .pptx-thumbnail>svg{width:110px;height:auto;display:block;margin:auto}.pptx-fidelity-warning{padding:8px;margin:0 0 12px;color:var(--color-text-secondary)}.open-doc[data-source-kind=pptx] [data-export=pdf]{display:none}

/* Text selection annotations live below the selectable PDF text layer. */
.semantic-overlays{position:absolute;inset:0;z-index:2;pointer-events:none}
.semantic-fragment{position:absolute;box-sizing:border-box;pointer-events:none}
.semantic-fragment.underline{border-bottom:2px solid}
.semantic-fragment.strikeout::after{content:"";position:absolute;left:0;right:0;top:50%;border-top:2px solid; border-color:inherit}
.semantic-selection-menu{
  position:fixed;z-index:200;display:flex;align-items:center;flex-wrap:wrap;
  gap:4px;max-width:min(440px,calc(100vw - 16px));padding:7px;
  background:var(--color-panel);border:1px solid var(--color-border);
  border-radius:8px;box-shadow:0 8px 25px #0004
}
.semantic-selection-menu[hidden]{display:none}
.semantic-selection-menu button,.semantic-annotation-editor button{
  border:1px solid var(--color-border);color:var(--color-text-primary);
  background:var(--color-panel);border-radius:5px;padding:5px 7px;cursor:pointer
}
.semantic-selection-menu button:hover,.semantic-annotation-editor button:hover{
  background:var(--color-workspace)
}
.semantic-selection-menu input[type=color]{width:32px;height:30px;padding:1px}
.fixed-document{grid-template-columns:220px minmax(0,1fr)}
.semantic-annotation-panel{border-top:1px solid var(--color-border);margin-top:8px;padding-top:8px;min-width:0}
.semantic-annotation-panel h3{font-size:13px;font-weight:650;margin:0 0 8px}
.semantic-annotation-list{display:flex;flex-direction:column;gap:5px;max-height:230px;overflow:auto}
.semantic-annotation-list button{width:100%;min-width:0;text-align:left;overflow-wrap:anywhere;font-size:12px}
.semantic-annotation-list button[aria-pressed=true]{background:var(--color-workspace)}
.semantic-annotation-editor{display:flex;flex-direction:column;gap:8px;margin-top:8px}
.semantic-annotation-editor p{font-size:12px;line-height:1.45;margin:0;overflow-wrap:anywhere}
.semantic-annotation-editor label{display:flex;flex-direction:column;gap:5px;font-size:12px}
.semantic-annotation-editor textarea{width:100%;box-sizing:border-box;resize:vertical;min-height:72px;color:var(--color-text-primary);background:var(--color-panel);border:1px solid var(--color-border);border-radius:5px}
.semantic-annotation-editor input[type=color]{width:40px;height:30px}

/* PDF review tools: selection notes, filters and an accessible side panel. */
.semantic-annotation-tools{display:grid;grid-template-columns:minmax(0,1fr);gap:7px;margin:10px 0}
.semantic-annotation-tools input,.semantic-annotation-tools select{width:100%;min-width:0;border:1px solid var(--color-border);background:var(--color-panel);color:var(--color-text-primary);padding:8px;border-radius:9px}
.semantic-annotation-tools .semantic-summary{border:1px solid var(--color-primary);color:var(--color-primary);border-radius:9px;padding:8px;background:var(--color-primary-soft);font-weight:600}
.semantic-note-pin{position:absolute!important;z-index:12;display:grid;place-items:center;width:24px;height:24px;border-radius:8px 8px 8px 2px;border:1px solid rgba(0,0,0,.17);box-shadow:0 3px 9px rgba(0,0,0,.2);cursor:pointer;pointer-events:auto!important;color:#181b1f;font-size:16px}
.semantic-note-pin:hover,.semantic-note-pin:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px;transform:scale(1.08)}
.semantic-empty{padding:10px;margin:0;color:var(--color-text-secondary);font-size:12px}
.semantic-annotation-editor input[type=range]{width:100%;accent-color:var(--color-primary)}
.open-doc .fixed-controls button[aria-pressed=true]{color:var(--color-primary);background:var(--color-primary-soft)}


/* Separate navigation thumbnails from comments: full-width reading area. */
.open-doc .fixed-document[data-annotation-pane="true"]:not([data-slide-editor="true"]){
  grid-template-columns:176px minmax(0,1fr) minmax(260px,320px);
}
.open-doc .semantic-notes-rail{
  grid-column:3;grid-row:2;min-width:0;min-height:0;overflow-y:auto;
  background:var(--color-panel);border-left:1px solid var(--color-border);
  padding:18px 16px;box-sizing:border-box;
}
.open-doc .semantic-notes-rail[hidden],.open-doc .semantic-note-balloon[hidden],
.open-doc .semantic-rail-toggle[hidden]{display:none!important}
.open-doc .semantic-notes-rail .semantic-annotation-panel{
  border:0;margin:0;padding:0;
}
.open-doc .semantic-annotation-panel h3{font-size:16px;line-height:1.4;margin:0 0 12px}
.open-doc .semantic-annotation-list{max-height:clamp(190px,38vh,420px);gap:9px}
.open-doc .semantic-annotation-list button{
  text-align:left;line-height:1.5;padding:11px 12px;min-height:44px;
  border:1px solid var(--color-border);border-radius:10px;
  background:var(--of-surface-low);white-space:normal;
}
.open-doc .semantic-annotation-editor{
  padding-top:14px;border-top:1px solid var(--color-border);
  margin-top:16px;gap:12px;
}
.open-doc .semantic-annotation-editor button{min-height:36px;padding:8px 10px}
.open-doc .semantic-rail-toggle{
  border-color:var(--color-border);min-height:34px;border-radius:8px;
}
.open-doc .semantic-rail-toggle[aria-expanded=true]{
  border-color:var(--color-primary);background:var(--color-primary-soft);
  color:var(--color-primary);
}
.open-doc .semantic-note-balloon{
  position:fixed;z-index:250;box-sizing:border-box;
  padding:16px;display:flex;flex-direction:column;gap:11px;
  max-width:calc(100vw - 24px);max-height:calc(100vh - 24px);overflow:auto;
  border:1px solid var(--color-border);border-radius:14px;
  box-shadow:0 14px 50px rgba(0,0,0,.22);background:var(--color-panel);
  color:var(--color-text-primary);
}
.open-doc .semantic-note-balloon strong{font-size:15px}
.open-doc .semantic-balloon-quote{
  margin:0;padding:10px;border-radius:8px;
  border-left:3px solid var(--color-primary);
  background:var(--of-surface-low);font-size:13px;line-height:1.5;
}
.open-doc .semantic-note-balloon label{display:flex;flex-direction:column;gap:7px;font-size:13px}
.open-doc .semantic-note-balloon textarea{
  box-sizing:border-box;resize:vertical;min-height:76px;width:100%;
  border:1px solid var(--color-border);border-radius:9px;
  background:var(--of-surface-low);color:var(--color-text-primary);
  padding:10px;font:inherit;
}
.open-doc .semantic-balloon-actions{display:flex;justify-content:flex-end;gap:8px}
.open-doc .semantic-balloon-actions button{
  border:1px solid var(--color-border);background:var(--of-surface-low);
  color:var(--color-text-primary);border-radius:8px;padding:8px 12px;
}

/* Ctrl+F-style search marks are painted over the text layer, without changing
 * PDF text nodes or invalidating highlight/comment anchors. */
.open-doc .pdf-search-overlays{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:5}
.open-doc .pdf-search-hit{position:absolute;box-sizing:border-box;background:rgba(255,211,50,.48);box-shadow:0 0 0 1px rgba(173,104,0,.54) inset;border-radius:2px}

/* Shared state vocabulary. A focus fallback also works without :focus-visible. */
.open-doc button,
.open-doc summary,
.open-doc input,
.open-doc select {
    transition: background-color var(--motion-fast), color var(--motion-fast), border-color var(--motion-fast);
}
.open-doc button:hover:not(:disabled),
.open-doc .library-file-actions > summary:hover {
    background: var(--color-hover);
}
.open-doc button:active:not(:disabled) {
    background: var(--color-primary-soft);
}
.open-doc :focus {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
}
.open-doc :focus:not(:focus-visible) {
    outline: none;
}
.open-doc :focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
}
.open-doc button:disabled,
.open-doc input:disabled,
.open-doc select:disabled {
    color: var(--color-text-disabled);
    cursor: default;
    opacity: .55;
}
.open-doc .menubar [aria-expanded='true'],
.open-doc .toolbar [aria-pressed='true'],
.open-doc .dropdown [aria-checked='true'],
.open-doc .library-file-actions[open] > summary {
    color: var(--color-primary);
    background: var(--color-primary-soft);
}
.open-doc [data-outline] button[data-active='true'],
.open-doc [data-outline] button:hover {
    color: var(--color-primary);
    background: var(--color-primary-soft);
    border-left-color: var(--color-primary);
}
.open-doc input[data-title]:hover,
.open-doc input[data-title]:focus {
    border-color: var(--color-border);
    background: var(--color-panel);
}
.open-doc[data-saving='true'] .save-status {
    color: var(--color-primary);
}
.open-doc .primary-button:hover:not(:disabled),
.open-doc [data-dialog-confirm]:hover:not(:disabled) {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
}
.open-doc .primary-button:active:not(:disabled),
.open-doc [data-dialog-confirm]:active:not(:disabled) {
    background: var(--color-primary-active);
}
.open-doc .danger-action:hover:not(:disabled),
.open-doc .danger-action:focus-visible {
    background: var(--color-danger-soft);
    color: var(--color-danger);
}

/* Never hide the export destination in a truncated status bar. */
.open-doc .export-result:not(:empty){
  position:fixed;z-index:var(--z-dialog);left:50%;bottom:48px;
  transform:translateX(-50%);
  display:flex;align-items:flex-start;gap:13px;justify-content:space-between;
  width:min(610px,calc(100vw - 32px));box-sizing:border-box;
  padding:14px 16px;line-height:1.5;overflow-wrap:anywhere;
  background:var(--color-panel);color:var(--color-text-primary);
  border:1px solid var(--color-border);border-left:4px solid var(--color-primary);
  box-shadow:0 8px 30px rgba(0,0,0,.18);border-radius:12px;font-size:13px;
}
.open-doc .export-result button{
  flex:0 0 auto;border:1px solid var(--color-border);
  background:var(--of-surface-low);border-radius:8px;padding:7px 12px;
  color:var(--color-text-primary);min-height:34px;
}

/* Icon via CSS preserves exact export destination in DOM text for automation. */
.open-doc .export-result button::after{content:"×";font-size:20px;line-height:1}
.open-doc .export-result button{min-width:36px;font-size:0}

/* Ofício Aberto visual language adapted to Open Doc desktop, from local tokens.
   No external fonts, Tailwind CDN or substitute runtime. */
.open-doc {
    --color-app-chrome: #f7f9fb;
    --color-workspace: #eceef0;
    --color-panel: #ffffff;
    --color-text-primary: #191c1e;
    --color-text-secondary: #5c647a;
    --color-text-muted: #737686;
    --color-border-strong: #c3c6d7;
    --color-border: #e0e3e5;
    --color-border-soft: #eceef0;
    --color-primary: #004ac6;
    --color-primary-hover: #003ea8;
    --color-primary-active: #002e80;
    --color-primary-soft: #dae2fd;
    --color-on-primary: #ffffff;
    --color-hover: #f2f4f6;
    --color-danger: #ba1a1a;
    --color-danger-soft: #ffdad6;
    --color-opaque: #f2f4f6;
    --color-paper-link: #004ac6;
    --color-success: #26734d;
    --of-surface: #f7f9fb;
    --of-surface-low: #f2f4f6;
    --of-surface-high: #e6e8ea;
    --of-surface-highest: #e0e3e5;
    --of-secondary: #565e74;
    --of-tertiary: #46566c;
    --of-primary-fixed: #dbe1ff;
    --radius-xs: 5px;
    --radius-sm: 7px;
    --radius-md: 10px;
    --radius-lg: 12px;
    --shadow-menu: 0 14px 40px rgba(25,28,30,.14),0 3px 10px rgba(25,28,30,.07);
    --shadow-paper: 0 3px 18px rgba(25,28,30,.12);
    --header-height: 58px;
    --menubar-height: 36px;
    --toolbar-min-height: 52px;
    --statusbar-height: 32px;
    --navigator-width: 250px;
    --navigator-collapsed-width: 46px;
    --home-max-width: 1200px;
    --control-icon-width: 36px;
    --control-height-md: 36px;
    --control-height-sm: 32px;
    --control-height-lg: 42px;
    --font-size-sm: 12px;
    --font-size-md: 13px;
    --font-size-lg: 15px;
    --font-size-xl: 17px;
    --font-size-2xl: 22px;
    --font-size-3xl: 30px;
    --motion-fast: 120ms;
    --motion-normal: 200ms;
}
.open-doc[data-theme="dark"] {
    --color-app-chrome: #191c22;
    --color-workspace: #181c24;
    --color-panel: #252a34;
    --color-text-primary: #eff1f3;
    --color-text-secondary: #bec6d4;
    --color-text-muted: #a0aabc;
    --color-border: #3d4654;
    --color-border-soft: #323a46;
    --color-border-strong: #5d697a;
    --color-primary: #b4c5ff;
    --color-primary-hover: #dbe1ff;
    --color-primary-active: #91adfc;
    --color-primary-soft: #293e64;
    --color-on-primary: #00174b;
    --color-hover: #333d4b;
    --color-danger: #ffb4ab;
    --color-danger-soft: #602d36;
    --of-surface: #191c22;
    --of-surface-low: #222833;
    --of-surface-high: #303846;
    --of-surface-highest: #3a4453;
    --of-secondary: #c6cee5;
    --of-tertiary: #b7c8e1;
    --of-primary-fixed: #293e64;
}
.open-doc .app-header {
    background: var(--color-panel);
    border-bottom: 1px solid var(--color-border-soft);
    gap: 12px;
    padding: 0 20px;
    box-shadow: 0 2px 9px rgba(0,0,0,.035);
}
.open-doc .product {
    gap: 10px;
    padding: 6px 9px 6px 0;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--color-text-primary);
}
.open-doc .product .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 4px 12px rgba(0,74,198,.16);
}
.open-doc .product .brand-mark svg { width: 21px; height: 21px; color: currentColor; }
.open-doc .header-divider { height: 24px; }
.open-doc input[data-title] {
    flex: 1 1 210px;
    width: auto;
    max-width: 360px;
    height: 36px;
    padding: 0 12px;
    font-weight: 600;
}
.open-doc .save-status { flex-basis: 220px; width: 220px; font-size: 12px; }
.open-doc .header-actions { display: flex; align-items: center; gap: 4px; margin-left: auto; }
.open-doc .header-actions .icon-button { width: 40px; min-width: 40px; height: 40px; border-radius: 50%; }
.open-doc .header-actions .icon-button svg { width: 21px; height: 21px; }
.open-doc .header-actions .header-new { color: var(--color-primary); }
.open-doc .menubar { border-bottom: 1px solid var(--color-border-soft); align-items: center; gap: 6px; padding: 0 16px; }
.open-doc .menubar [data-menu] { padding-inline: 12px; font-size: 13px; border-radius: 8px; }
.open-doc .menubar [aria-expanded="true"] { font-weight: 600; }
.open-doc .toolbar {
    padding: 6px 16px;
    gap: 8px;
    background: var(--color-panel);
    border-top: 0;
    border-bottom: 1px solid var(--color-border);
    scrollbar-width: thin;
}
.open-doc .toolbar-group { gap: 4px; }
.open-doc .toolbar-group + .toolbar-group { padding-left: 9px; }
.open-doc .toolbar .icon-button { height: 36px; width: 36px; min-width: 36px; border-radius: 9px; }
.open-doc .toolbar .icon-button svg { width: 20px; height: 20px; }
.open-doc .toolbar select,
.open-doc .toolbar input[type="number"] { min-height: 35px; border-radius: 8px; }
.open-doc .toolbar [data-font-family] { width: 155px; }
.open-doc .toolbar [data-paragraph] { width: 138px; }
.open-doc .toolbar [data-font-size] { width: 55px; }
.open-doc .toolbar [data-toolbar-group="decoration"] button { font-weight: 600; }
.open-doc .toolbar [data-toolbar-group="colors"] label { background: var(--of-surface-low); padding: 2px 5px; border-radius: 7px; }
.open-doc .document-quickbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    background: var(--of-surface-low);
    border-bottom: 1px solid var(--color-border-soft);
    min-height: 42px;
    overflow-x: auto;
    flex-shrink: 0;
}
.open-doc .document-quickbar .quickbar-title { display: inline-flex; gap: 7px; align-items: center; margin-right: 14px; font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
.open-doc .document-quickbar .quickbar-title svg { width: 18px; color: var(--color-primary); }
.open-doc .document-quickbar button { display: inline-flex; gap: 6px; align-items: center; white-space: nowrap; border-radius: 999px; padding: 4px 12px; min-height: 30px; color: var(--color-text-secondary); }
.open-doc .document-quickbar button svg { width: 16px; height: 16px; }
.open-doc .document-quickbar button[data-active="true"] { background: var(--color-panel); color: var(--color-primary); box-shadow: 0 1px 5px rgba(0,0,0,.08); font-weight: 600; }
.open-doc .document-quickbar .quickbar-divider { align-self: stretch; border-left: 1px solid var(--color-border); margin-inline: 3px; }
.open-doc .navigator { background: var(--color-panel); border-color: var(--color-border-soft); }
.open-doc .navigator-header { min-height: 48px; font-size: 11px; padding-inline: 16px; }
.open-doc .navigator-document { margin-inline: 8px; border-radius: 9px; font-weight: 600; }
.open-doc .navigator-content { padding-inline: 16px; }
.open-doc .find-field { border-radius: 10px; background: var(--of-surface-low); border-color: transparent; }
.open-doc .find-field [data-find] { background: transparent; }
.open-doc .document-canvas,.open-doc .fixed-scroll { background: var(--color-workspace); }
.open-doc .document-page,.open-doc .fixed-surface { box-shadow: var(--shadow-paper); }
.open-doc .statusbar { padding-inline: 14px; background: var(--color-panel); }
.open-doc .dropdown,.open-doc .document-action-menu,.open-doc .page-menu { border-radius: 12px; padding: 6px; }
.open-doc .dropdown button,.open-doc .document-action-menu button { border-radius: 7px; min-height: 35px; }
.open-doc .ink-toolbar,.open-doc .fixed-controls {
    padding: 8px 14px;
    gap: 6px;
    background: var(--color-panel);
    border-bottom: 1px solid var(--color-border-soft);
}
.open-doc .ink-toolbar button,.open-doc .fixed-controls button {
    border-color: transparent;
    background: var(--of-surface-low);
    min-height: 35px;
    border-radius: 9px;
    padding: 6px 11px;
    font-weight: 500;
}
.open-doc .ink-toolbar button[aria-pressed="true"] { background: var(--color-primary-soft); color: var(--color-primary); }
.open-doc .fixed-controls input { border-radius: 9px; }
.open-doc .fixed-sidebar { background: var(--color-panel); }
.open-doc .fixed-sidebar [data-thumbnail-index] { background: var(--of-surface-low); border: 1px solid var(--color-border); border-radius: 10px; margin-bottom: 5px; }
.open-doc .fixed-sidebar [data-thumbnail-index]:hover { border-color: var(--color-primary); }
.open-doc .dialog { border-radius: 16px; box-shadow: var(--shadow-menu); }
.open-doc .home { background: var(--of-surface); }
.open-doc .home-inner { padding: 26px 0 56px; }
.open-doc .home-intro { color: var(--color-text-secondary); line-height: 1.55; margin: 4px 0 0; }
.open-doc .home-product { letter-spacing: .09em; margin-bottom: 6px; font-weight: 700; }
.open-doc .home h1 { font-size: 30px; font-weight: 700; letter-spacing: -.04em; margin: 0; }
.open-doc .home-hero { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 22px; }
.open-doc .home-hero button { display: flex; gap: 8px; align-items: center; border-radius: 99px; background: var(--color-primary); color: var(--color-on-primary); min-height: 42px; padding: 10px 16px; font-weight: 600; }
.open-doc .home-hero button svg { width: 19px; }
.open-doc .home-status-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: var(--color-panel);
    border: 1px solid var(--color-border-soft);
    box-shadow: 0 3px 11px rgba(25,28,30,.03);
}
.open-doc .home-status-banner .status-symbol { display: grid; place-items: center; background: var(--color-primary-soft); color: var(--color-primary); width: 42px; height: 42px; border-radius: 50%; flex: 0 0 auto; }
.open-doc .home-status-banner .status-symbol svg { width: 21px; height: 21px; }
.open-doc .home-status-banner strong { display: block; font-weight: 600; font-size: 13px; }
.open-doc .home-status-banner p { margin: 3px 0 0; color: var(--color-text-secondary); font-size: 12px; }
.open-doc .home-status-badge { margin-left: auto; padding: 7px 12px; background: var(--of-surface-low); border-radius: 99px; color: var(--color-text-secondary); font-size: 11px; font-weight: 600; white-space: nowrap; }
.open-doc .home-search { position: relative; display: flex; align-items: center; gap: 9px; padding: 0 14px; height: 48px; background: var(--of-surface-low); border-radius: 12px; margin-bottom: 14px; border: 1px solid transparent; }
.open-doc .home-search:focus-within { background: var(--color-panel); border-color: var(--color-primary); }
.open-doc .home-search svg { color: var(--color-text-secondary); width: 21px; }
.open-doc .home-search input { width: 100%; background: transparent; border: 0; font-size: 13px; min-height: 42px; outline: 0; }
.open-doc .home-search input:focus { outline: 0; }
.open-doc .home-search .search-clear { border: 0; border-radius: 50%; width: 32px; min-width: 32px; height: 32px; display: grid; place-items: center; }
.open-doc .home-filters { display: flex; gap: 8px; flex-wrap: nowrap; overflow-x: auto; margin-bottom: 28px; scrollbar-width: none; }
.open-doc .home-filters button { white-space: nowrap; padding: 7px 14px; min-height: 34px; border-radius: 999px; background: var(--of-surface-low); color: var(--color-text-secondary); font-weight: 600; font-size: 12px; }
.open-doc .home-filters button[aria-pressed="true"] { color: var(--color-on-primary); background: var(--color-text-primary); }
.open-doc .home-filters .format-dot { display: inline-block; border-radius: 50%; width: 8px; height: 8px; margin-right: 4px; background: var(--color-primary); }
.open-doc .home-filters [data-library-filter="pdf"] .format-dot { background: #ba1a1a; }
.open-doc .home-filters [data-library-filter="pptx"] .format-dot { background: #46566c; }
.open-doc .home-filters [data-library-filter="md"] .format-dot { background: #737686; }
.open-doc .home-section-heading { display: flex; align-items: center; gap: 9px; justify-content: space-between; margin-bottom: 13px; }
.open-doc .home-section-heading h2,.open-doc .recent-heading h2 { margin: 0; font-size: 16px; font-weight: 700; color: var(--color-text-primary); }
.open-doc .home-section-heading .heading-note { color: var(--color-text-secondary); font-size: 12px; font-weight: 500; }
.open-doc .home-create-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; margin: 0 0 32px; }
.open-doc .home-create-card { display: flex; flex-direction: column; text-align: left; gap: 15px; background: var(--color-panel); padding: 18px; min-height: 156px; border: 1px solid var(--color-border-soft); border-radius: 15px; box-shadow: 0 2px 10px rgba(25,28,30,.035); transition: border-color var(--motion-fast), transform var(--motion-fast); }
.open-doc .home-create-card:hover:not(:disabled) { background: var(--color-panel); border-color: var(--color-primary); transform: translateY(-2px); }
.open-doc .home-create-card .home-card-icon { display: grid; place-items: center; border-radius: 11px; width: 44px; height: 44px; background: var(--color-primary-soft); color: var(--color-primary); }
.open-doc .home-create-card .home-card-icon.pdf { color: #ba1a1a; background: #ffdad6; }
.open-doc .home-create-card .home-card-icon.slides { color: #46566c; background: #d3e4fe; }
.open-doc .home-create-card .home-card-icon.scan { color: var(--color-text-primary); background: var(--of-surface-high); }
.open-doc .home-create-card .home-card-icon svg { width: 24px; height: 24px; }
.open-doc .home-create-card strong { display: block; font-size: 14px; font-weight: 600; color: var(--color-text-primary); margin-bottom: 4px; }
.open-doc .home-create-card small { display: block; font-size: 12px; color: var(--color-text-secondary); line-height: 1.4; }
.open-doc .home-create-card:disabled { opacity: .55; cursor: not-allowed; }
.open-doc .recent-heading { margin: 18px 0 13px; }
.open-doc .recent-heading h2 { font-size: 16px; font-weight: 700; }
.open-doc .document-list { border-top: 0; display: grid; gap: 9px; }
.open-doc .library-row { display: grid; grid-template-columns: 54px minmax(0, 1fr) auto auto; gap: 14px; padding: 13px 16px; min-height: 76px; border: 1px solid var(--color-border-soft); border-radius: 13px; background: var(--color-panel); }
.open-doc .library-row:hover { background: var(--of-surface-low); border-color: var(--color-border); }
.open-doc .library-file-icon { border: 0; background: var(--of-surface-low); width: 48px; height: 53px; border-radius: 8px; display: flex; flex-direction: column; justify-content: center; gap: 2px; font-size: 10px; font-weight: 700; }
.open-doc .library-file-icon svg { width: 21px; height: 21px; }
.open-doc .library-file-icon[data-format="pdf"] { color: #ba1a1a; background: #ffdad6; }
.open-doc .library-file-icon[data-format="pptx"] { color: #46566c; background: #d3e4fe; }
.open-doc .library-file-title { font-size: 14px; font-weight: 600; }
.open-doc .library-file-meta { font-size: 12px; margin-top: 3px; }
.open-doc .library-file-kind { font-size: 11px; background: var(--of-surface-low); border-radius: 99px; padding: 6px 10px; }
.open-doc .library-file-actions { width: 36px; }
.open-doc .library-file-actions > summary { width: 36px; height: 36px; border-radius: 50%; }
.open-doc .home-bottom-nav { display: none; }
.open-doc .home-fab { display: none; }
.open-doc .home-quick-menu { position: fixed; right: 20px; bottom: 94px; z-index: 45; padding: 9px; border-radius: 13px; min-width: 200px; background: var(--color-panel); border: 1px solid var(--color-border); box-shadow: var(--shadow-menu); }
.open-doc .home-quick-menu button { width: 100%; display: flex; gap: 10px; align-items: center; text-align: left; padding: 11px; border-radius: 9px; }
.open-doc .home-quick-menu svg { color: var(--color-primary); }
.open-doc .home [hidden],.open-doc .home-quick-menu[hidden] { display: none !important; }

/* State is explicit; HTML hidden always wins over layout declarations. */
.open-doc[data-home-view="true"] .menubar,
.open-doc[data-home-view="true"] .toolbar,
.open-doc[data-home-view="true"] .document-quickbar { display: none; }
.open-doc[data-home-view="true"] .app-header input[data-title],
.open-doc[data-home-view="true"] .app-header .save-status,
.open-doc[data-home-view="true"] .header-divider { display: none; }
.open-doc .document-quickbar .quickbar-rich { display: inline-flex; align-items: center; gap: 4px; }
.open-doc .document-quickbar .quickbar-rich[hidden],
.open-doc .document-quickbar [hidden],
.open-doc .library-row[hidden],
.open-doc [data-filter-empty][hidden] { display: none !important; }
.open-doc .document-quickbar .quickbar-local { margin-left: auto; font-size: 11px; color: var(--color-text-secondary); white-space: nowrap; }
.open-doc .home-quick-menu button:hover { background: var(--color-hover); }
.open-doc .home-filters button:focus-visible,.open-doc .home-create-card:focus-visible { outline-offset: 2px; }
.open-doc .home .library-empty { background: var(--color-panel); border-radius: 12px; padding: 16px; margin: 12px 0; }
.open-doc .document-quickbar button:disabled { opacity: .4; }
.open-doc .toolbar [data-command="underline"],.open-doc .toolbar [data-command="strike"] { font-size: 17px; }
.open-doc .fixed-controls input[type="search"] { width: min(220px, 28vw); }

.open-doc .ink-toolbar [data-ink-mode],.open-doc .fixed-controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
}
.open-doc .ink-toolbar [data-ink-mode] svg,.open-doc .fixed-controls button svg { width: 18px; height: 18px; }
.open-doc .ink-toolbar [data-ink-mode="eraser-partial"] { color: var(--color-primary); }

/* The PDF semantic toolbar and annotations remain wired to the real parser. */
.open-doc .semantic-selection-menu {
    border-radius: 13px;
    padding: 7px;
    gap: 4px;
    box-shadow: var(--shadow-menu);
}
.open-doc .semantic-selection-menu button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 10px;
    border: 0;
    border-radius: 9px;
    background: var(--of-surface-low);
    color: var(--color-text-primary);
}
.open-doc .semantic-selection-menu button svg { width: 16px; height: 16px; }
.open-doc .semantic-selection-menu input[type="color"] { border-radius: 8px; }
.open-doc .semantic-annotation-panel {
    border-top: 1px solid var(--color-border-soft);
    margin-top: 14px;
    padding-top: 13px;
}
.open-doc .semantic-annotation-panel h3 { font-weight: 700; font-size: 14px; }
.open-doc .semantic-annotation-list { gap: 7px; }
.open-doc .semantic-annotation-list button {
    border-radius: 9px;
    border: 1px solid var(--color-border-soft);
    background: var(--of-surface-low);
    text-align: left;
    padding: 10px;
}
.open-doc .semantic-annotation-list button[aria-pressed="true"] {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
    color: var(--color-text-primary);
}
.open-doc .semantic-annotation-editor textarea {
    border-radius: 10px;
    background: var(--of-surface-low);
}

/* Native slide composition, presented inside Vela's existing fixed document view. */
.open-doc .fixed-document[data-slide-editor="true"]{
  grid-template-columns:180px minmax(0,1fr) 268px;
  grid-template-rows:auto minmax(0,1fr);
}
.open-doc .fixed-document[data-slide-editor="true"] .fixed-controls{grid-column:1/-1;flex-wrap:wrap;gap:6px}
.open-doc .slide-studio-toolbar{display:flex;align-items:center;gap:4px;overflow-x:auto;flex:1 1 100%;padding-top:6px;border-top:1px solid var(--color-border-soft);scrollbar-width:thin}
.open-doc .slide-studio-toolbar[hidden],.open-doc .slide-inspector[hidden]{display:none!important}
.open-doc .slide-studio-toolbar button{border-radius:9px;white-space:nowrap;flex-shrink:0;background:var(--of-surface-low);padding:6px 11px;min-height:33px;color:var(--color-text-primary)}
.open-doc .slide-studio-toolbar button:hover{background:var(--color-primary-soft);color:var(--color-primary)}
.open-doc .fixed-document[data-slide-editor="true"] .fixed-sidebar{grid-column:1;grid-row:2;background:var(--color-panel);border-right:1px solid var(--color-border-soft);gap:10px;padding:12px}
.open-doc .fixed-document[data-slide-editor="true"] .fixed-scroll{grid-column:2;grid-row:2;min-width:0;overflow:auto;background:var(--color-workspace);padding:24px 20px}
.open-doc .fixed-document[data-slide-editor="true"] .fixed-surface{position:relative;background:#fff;box-shadow:var(--shadow-paper);border-radius:2px;overflow:hidden}
.open-doc .slide-object-layer{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;overflow:hidden;z-index:1;pointer-events:none;user-select:none}
.open-doc .slide-object{position:absolute;box-sizing:border-box;border:1.5px solid;white-space:pre-wrap;overflow:hidden;padding:6px;line-height:1.18;cursor:move;touch-action:none;color:#191c1e}
.open-doc .slide-object-text{border-color:transparent!important;background:transparent;word-break:break-word;overflow-wrap:anywhere}
.open-doc .slide-object-ellipse{border-radius:0}

/* Native SVG shapes: the wrapper remains responsible for drag/resize. */
.open-doc .slide-object:not(.slide-object-text){padding:0;border:0}
.open-doc .slide-object .slide-vector-shape{position:absolute;left:0;top:0;width:100%;height:100%;display:block;pointer-events:none}
.open-doc .slide-object[data-selected=true]{outline:2px solid #004ac6;outline-offset:2px;z-index:3}
.open-doc .slide-resize-handle{position:absolute;bottom:0;right:0;width:12px;height:12px;border:2px solid #fff;border-radius:2px;background:#004ac6;cursor:nwse-resize;touch-action:none}
.open-doc .slide-inspector{grid-column:3;grid-row:2;overflow-y:auto;display:flex;flex-direction:column;gap:10px;padding:16px;border-left:1px solid var(--color-border-soft);background:var(--color-panel);color:var(--color-text-primary)}
.open-doc .slide-inspector h3{font-size:15px;font-weight:700;margin:0 0 4px}
.open-doc .slide-inspector h4{font-size:12px;font-weight:700;margin:12px 0 0;padding-top:8px;border-top:1px solid var(--color-border-soft)}
.open-doc .slide-inspector label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--color-text-secondary)}
.open-doc .slide-inspector label input,.open-doc .slide-inspector label textarea{background:var(--of-surface-low);color:var(--color-text-primary);border:1px solid var(--color-border);border-radius:8px;padding:7px 9px;width:100%;min-width:0}
.open-doc .slide-inspector label input[type=color]{height:36px;padding:4px}
.open-doc .slide-inspector label textarea{resize:vertical;min-height:72px}
.open-doc .slide-layer-list,.open-doc .slide-layer-actions{display:flex;flex-direction:column;gap:5px}
.open-doc .slide-layer-list button,.open-doc .slide-layer-actions button{border:1px solid var(--color-border);background:var(--of-surface-low);padding:8px 10px;min-height:34px;border-radius:8px;text-align:left;font-size:12px}
.open-doc .slide-layer-list button[aria-pressed=true]{border-color:var(--color-primary);background:var(--color-primary-soft);color:var(--color-primary);font-weight:600}
.open-doc .slide-layer-actions button:last-child{color:var(--color-danger)}
.open-doc .slide-thumb-preview{display:block;position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;border:1px solid var(--color-border);border-radius:4px;background:#fff;margin-bottom:6px}
.open-doc .slide-thumb-preview .slide-object{padding:1px;border-width:.5px;cursor:default;overflow:hidden;line-height:1.05}
.open-doc .fixed-sidebar [data-thumbnail-index] .slide-thumb-preview{width:100%}
.open-doc .fixed-document[data-slide-editor="true"] .fixed-sidebar [data-thumbnail-index]{background:transparent;border:1px solid var(--color-border-soft);border-radius:10px;padding:7px;font-size:11px;text-align:left}
.open-doc .fixed-document[data-slide-editor="true"] .fixed-sidebar [data-thumbnail-index]:hover,.open-doc .fixed-document[data-slide-editor="true"] .fixed-sidebar [data-thumbnail-index]:focus-visible{border-color:var(--color-primary);background:var(--color-primary-soft)}

/* Compact contextual slide command strip. Icons come from local icons.svg. */
.open-doc .fixed-document[data-slide-editor="true"] .fixed-controls{
  flex-wrap:nowrap;overflow-x:auto;overflow-y:hidden;gap:4px;
  min-width:0;padding:5px 9px;scrollbar-width:thin;
}
.open-doc .fixed-document[data-slide-editor="true"] .slide-studio-toolbar{
  flex:0 0 auto;border:0;padding:0;margin:0 9px 0 0;
  gap:3px;overflow:visible;min-width:0;
  border-right:1px solid var(--color-border-soft);
  padding-right:10px;
}
.open-doc .slide-studio-toolbar button{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  min-height:33px;padding:5px 9px;font-size:12px;
  background:var(--of-surface-low);border:1px solid transparent;
  transition:background .12s ease,border-color .12s ease;
}
.open-doc .slide-studio-toolbar button:focus-visible{
  outline:2px solid var(--color-primary);outline-offset:1px;
}
.open-doc .slide-studio-toolbar button:hover{border-color:var(--color-border-soft);}
.open-doc .slide-studio-toolbar .slide-action-icon{
  display:inline-block;width:17px;height:17px;flex:none;
  pointer-events:none;color:currentColor;stroke:currentColor;fill:none;
}
.open-doc .fixed-document[data-slide-editor="true"] .fixed-scroll{
  min-width:0;min-height:0;overflow:auto;
}
.open-doc .fixed-document[data-slide-editor="true"] .slide-inspector{
  min-width:0;overflow-y:auto;
}
.open-doc .slide-layer-list button{
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}


/* Ribbon organized by user task, not an endless mixed PDF/PPTX command row. */
.open-doc .fixed-document[data-slide-editor="true"] .fixed-controls{
  flex-wrap:wrap;overflow-x:hidden;overflow-y:visible;
  row-gap:9px;column-gap:9px;padding:10px 12px;
}
.open-doc .fixed-document[data-slide-editor="true"] .slide-studio-toolbar{
  order:2;flex:1 1 100%;display:flex;flex-direction:column;
  align-items:stretch;gap:8px;padding:0;margin:2px 0 0;
  border:0;overflow:visible;
}
.open-doc .slide-ribbon-tabs{display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--color-border-soft);min-height:36px}
.open-doc .slide-ribbon-tab{
  border-radius:8px 8px 0 0!important;padding:8px 16px!important;
  background:transparent!important;min-height:34px;font-weight:600;
}
.open-doc .slide-ribbon-tab[aria-selected=true]{
  color:var(--color-primary)!important;border-bottom:3px solid var(--color-primary)!important;
}
.open-doc .slide-ribbon-body{display:flex;min-width:0;max-width:100%}
.open-doc .slide-ribbon-group{
  display:flex;flex-wrap:wrap;align-items:center;gap:8px;
  min-height:40px;max-width:100%;padding-bottom:2px;
}
.open-doc .slide-ribbon-group[hidden]{display:none!important}
.open-doc .slide-ribbon-group button{
  min-height:37px;padding:7px 12px;white-space:nowrap;
  border-radius:9px;border:1px solid var(--color-border-soft);
}
.open-doc .slide-paint-selector{
  display:inline-flex;align-items:center;gap:8px;padding:3px 11px;
  border:1px solid var(--color-border-soft);border-radius:9px;
  color:var(--color-text-secondary);font-size:12px;
}
.open-doc .slide-paint-selector input{width:38px;height:30px;border:0;cursor:pointer}
.open-doc .slide-ribbon-group button[aria-pressed=true]{
  background:var(--color-primary-soft)!important;
  border-color:var(--color-primary);color:var(--color-primary)!important;
}
.open-doc .slide-inspector{gap:14px;padding:20px 18px}
.open-doc .slide-inspector h4{font-size:13px;margin-top:15px}
.open-doc .slide-inspector label{gap:7px;font-size:13px}
.open-doc .slide-inspector label input,.open-doc .slide-inspector label textarea{
  padding:10px 12px;min-height:39px;
}
.open-doc .slide-layer-list,.open-doc .slide-layer-actions{gap:9px}
.open-doc .slide-layer-list button,.open-doc .slide-layer-actions button{
  min-height:40px;padding:10px 12px;font-size:13px;
}

/* All eight editing handles and one rotation control remain accessible. */
.open-doc .slide-object[data-selected=true]{overflow:visible}
.open-doc .slide-resize-handle{
  position:absolute;box-sizing:border-box;
  width:12px;height:12px;z-index:6;
  border:2px solid white;border-radius:3px;background:var(--color-primary);
  touch-action:none;transform:translate(-50%,-50%);
}
.open-doc .slide-handle-nw{left:0;top:0;cursor:nwse-resize}
.open-doc .slide-handle-n{left:50%;top:0;cursor:ns-resize}
.open-doc .slide-handle-ne{left:100%;top:0;cursor:nesw-resize}
.open-doc .slide-handle-e{left:100%;top:50%;cursor:ew-resize}
.open-doc .slide-handle-se{left:100%;top:100%;cursor:nwse-resize}
.open-doc .slide-handle-s{left:50%;top:100%;cursor:ns-resize}
.open-doc .slide-handle-sw{left:0;top:100%;cursor:nesw-resize}
.open-doc .slide-handle-w{left:0;top:50%;cursor:ew-resize}
.open-doc .slide-rotate-handle{
  position:absolute;left:50%;top:-34px;transform:translateX(-50%);
  z-index:8;width:21px;height:21px;box-sizing:border-box;
  border:2px solid var(--color-primary);border-radius:50%;
  background:white;cursor:grab;touch-action:none;
}
.open-doc .slide-rotate-handle::after{
  content:"";position:absolute;left:50%;top:19px;height:13px;
  border-left:1.5px solid var(--color-primary);
}
.open-doc .slide-inline-editor{
  position:absolute;z-index:9;box-sizing:border-box;top:0;left:0;right:0;bottom:0;
  width:100%;height:100%;resize:none;overflow:auto;
  background:rgba(255,255,255,.96);border:1px solid var(--color-primary);
  outline:2px solid var(--color-primary);border-radius:2px;
  padding:6px;color:inherit;font:inherit;line-height:inherit;
  white-space:pre-wrap;word-break:break-word;
}

/* Visual preview only. Native PPTX export writes p:transition OOXML separately. */
@keyframes open-doc-transition-fade{
  from{opacity:0}to{opacity:1}
}
@keyframes open-doc-transition-push-left{
  from{opacity:.2;transform:translateX(22%)}to{opacity:1;transform:translateX(0)}
}
@keyframes open-doc-transition-push-right{
  from{opacity:.2;transform:translateX(-22%)}to{opacity:1;transform:translateX(0)}
}
@keyframes open-doc-transition-wipe-left{
  from{clip-path:inset(0 0 0 100%)}to{clip-path:inset(0)}
}
@keyframes open-doc-transition-wipe-right{
  from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0)}
}
.open-doc .slide-inspector select{
  display:block;box-sizing:border-box;min-height:39px;width:100%;
  border:1px solid var(--color-border);border-radius:9px;
  color:var(--color-text-primary);background:var(--of-surface-low);
  padding:8px 12px
}


/* Editable native chart preview and its row-based data source. */
.open-doc .slide-object-chart{background:#fff;overflow:hidden}
.open-doc .slide-chart-preview{
  position:absolute;left:0;top:0;display:block;
  box-sizing:border-box;width:100%;height:100%;pointer-events:none;
  border:1px solid #CBD5E1;border-radius:5px;background:#fff;
}
.open-doc .slide-chart-data{
  display:flex;flex-direction:column;gap:13px;margin-top:17px;
  padding:15px 0;border-top:1px solid var(--color-border);
}
.open-doc .slide-chart-data h4{margin:0;font-size:14px}
.open-doc .slide-chart-options{display:grid;grid-template-columns:1fr;gap:11px}
.open-doc .slide-chart-options label{
  display:flex;flex-direction:column;gap:7px;
  font-size:12px;color:var(--color-text-secondary)
}
.open-doc .slide-chart-options select,.open-doc .slide-chart-options input{
  min-height:39px;box-sizing:border-box;border:1px solid var(--color-border);
  border-radius:8px;background:var(--of-surface-low);
  color:var(--color-text-primary);padding:8px 10px;width:100%
}
.open-doc .slide-chart-hint{font-size:12px;line-height:1.6;margin:0}
.open-doc .slide-chart-grid{
  border-collapse:separate;border-spacing:0;width:100%;
  max-width:100%;font-size:12px
}
.open-doc .slide-chart-grid th{
  text-align:left;padding:8px 4px;color:var(--color-text-secondary);
  font-size:11px;border-bottom:1px solid var(--color-border)
}
.open-doc .slide-chart-grid td{padding:5px 2px;min-width:0}
.open-doc .slide-chart-grid td:first-child{width:48%}
.open-doc .slide-chart-grid td:nth-child(2){width:39%}
.open-doc .slide-chart-grid input{
  width:100%;min-width:0;box-sizing:border-box;padding:7px 6px;
  border:1px solid var(--color-border);border-radius:7px;
  background:var(--of-surface-low);color:var(--color-text-primary);
  font-size:12px;min-height:35px
}
.open-doc .slide-chart-grid button{min-width:26px;min-height:35px;
  color:var(--color-text-primary);border-radius:7px}
.open-doc .slide-chart-data>button{
  padding:9px;border:1px solid var(--color-border);border-radius:8px;
  background:var(--of-surface-low);color:var(--color-text-primary);
  min-height:37px;text-align:left
}

/* Desktop policy: one scrollable toolbar strip; never compress paper geometry. */
@media (max-width: 1439px) {
    .open-doc {
        --control-paragraph-width: 132px;
        --control-font-width: 140px;
        --control-select-width: 94px;
    }
    .open-doc .toolbar {
        gap: var(--space-1);
        padding-inline: var(--space-2);
    }
    .open-doc .toolbar-group + .toolbar-group {
        padding-left: var(--space-1);
    }
}
@media (max-width: 1199px) {
    .open-doc {
        --navigator-width: 200px;
    }
    .open-doc .save-status {
        width: 180px;
        flex-basis: 180px;
    }
}
@media (max-width: 959px) {
    .open-doc {
        --control-font-width: 128px;
        --control-paragraph-width: 124px;
        --control-select-width: 88px;
        --navigator-width: 180px;
    }
    .open-doc .save-status {
        width: 140px;
        flex-basis: 140px;
    }
    .open-doc .status-language,
    .open-doc .status-mode {
        display: none;
    }
    .open-doc .home-inner {
        padding-block: var(--space-8);
    }
}
@media (max-width: 719px) {
    .open-doc .status-divider {
        display: none;
    }
    .open-doc .status-left,
    .open-doc .status-right {
        gap: var(--space-1);
    }
    .open-doc .app-header {
        gap: var(--space-1);
        padding-inline: var(--space-1);
    }
    .open-doc .save-status {
        width: 96px;
        flex-basis: 96px;
    }
    .open-doc .menubar {
        padding-inline: var(--space-1);
        overflow-x: auto;
        overflow-y: hidden;
    }
    .open-doc .menubar [data-menu] {
        padding-inline: var(--space-1);
    }
    .open-doc .library-file-kind,
    .open-doc .recent-heading span,
    .open-doc .status-words {
        display: none;
    }
    .open-doc .library-row {
        grid-template-columns: 32px minmax(0,1fr) 32px;
        gap: var(--space-2);
    }
    .open-doc .home-inner {
        width: calc(100% - 32px);
    }
    .open-doc .home h1 {
        font-size: var(--font-size-2xl);
    }
    .open-doc .statusbar {
        gap: var(--space-1);
        padding-inline: var(--space-1);
    }
    .open-doc [data-zoom] {
        width: 64px;
    }
}
@media (max-height: 640px) {
    .open-doc .home-inner {
        padding-block: var(--space-6);
    }
    .open-doc .home-actions {
        margin-bottom: var(--space-6);
    }
    .open-doc .navigator-content {
        padding-top: var(--space-3);
    }
}
@media (prefers-reduced-motion: reduce) {
    .open-doc button,
    .open-doc summary,
    .open-doc input,
    .open-doc select {
        transition: none;
    }
}
@media (max-width: 479px) {
    .open-doc .product span,
    .open-doc .header-divider {
        display: none;
    }
    .open-doc .save-status {
        width: 64px;
        flex-basis: 64px;
    }
    .open-doc input[data-title] {
        min-width: 80px;
    }
}

@media(max-width:800px){.fixed-document{grid-template-columns:110px minmax(0,1fr)}.fixed-scroll{padding:12px}.ink-toolbar{gap:3px}}

/* Semantic PDF reader in narrow desktop windows. */
@media(max-width:760px){
  .fixed-document{grid-template-columns:140px minmax(0,1fr)}
  .fixed-scroll{padding:12px}
  .fixed-sidebar{padding:5px}
}

/* Ofício responsive shell: desktop tools retain full functions; compact views
   use a two-column library and a single-row scrollable command surface. */
@media (max-width: 1279px) {
    .open-doc .home-create-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .open-doc .home-inner { width: min(calc(100% - 36px), 980px); }
    .open-doc .header-actions { gap: 0; }
    .open-doc .document-quickbar .quickbar-local { display: none; }
}
@media (max-width: 959px) {
    .open-doc .home-hero { align-items: flex-start; }
    .open-doc .home h1 { font-size: 26px; }
    .open-doc .home-create-card { min-height: 128px; }
    .open-doc .header-actions .icon-button { min-width: 36px; width: 36px; }
    .open-doc .app-header { padding-inline: 12px; }
    .open-doc .document-quickbar { gap: 3px; padding-inline: 10px; }
    .open-doc .document-quickbar button { padding: 4px 8px; }
    .open-doc .document-quickbar .quickbar-title { margin-right: 4px; }
}
@media (max-width: 719px) {
    .open-doc .home-inner { width: calc(100% - 28px); padding-top: 18px; padding-bottom: 110px; }
    .open-doc .home-hero { display: block; margin-bottom: 14px; }
    .open-doc .home-hero button { display: none; }
    .open-doc .home h1 { font-size: 23px; line-height: 1.3; }
    .open-doc .home-intro { font-size: 12px; }
    .open-doc .home-status-banner { padding: 11px 12px; border-radius: 12px; gap: 8px; }
    .open-doc .home-status-banner .status-symbol { width: 34px; height: 34px; }
    .open-doc .home-status-badge { display: none; }
    .open-doc .home-create-grid { gap: 9px; }
    .open-doc .home-create-card { min-height: 120px; gap: 9px; padding: 12px; }
    .open-doc .home-create-card .home-card-icon { width: 39px; height: 39px; }
    .open-doc .home-create-card strong { font-size: 12px; }
    .open-doc .home-create-card small { font-size: 11px; }
    .open-doc .home-section-heading h2,.open-doc .recent-heading h2 { font-size: 15px; }
    .open-doc .library-row { padding: 11px; grid-template-columns: 42px minmax(0,1fr) 34px; gap: 9px; min-height: 66px; }
    .open-doc .library-file-icon { width: 40px; height: 45px; }
    .open-doc .library-file-title { font-size: 12px; }
    .open-doc .library-file-meta { font-size: 11px; }
    .open-doc .library-file-actions > summary { width: 34px; height: 34px; }
    .open-doc .home-bottom-nav {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 2px;
        align-items: center;
        width: 100%;
        min-height: 66px;
        padding: 5px 6px 6px;
        position: sticky;
        bottom: 0;
        background: var(--color-panel);
        border-top: 1px solid var(--color-border-soft);
        z-index: 20;
        box-shadow: 0 -3px 10px rgba(0,0,0,.04);
    }
    .open-doc .home-bottom-nav button { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 2px; font-size: 10px; border-radius: 11px; color: var(--color-text-secondary); min-height: 52px; padding: 5px; }
    .open-doc .home-bottom-nav button[aria-current="page"] { color: var(--color-primary); background: var(--color-primary-soft); }
    .open-doc .home-bottom-nav svg { width: 23px; height: 23px; }
    .open-doc .home-fab { display: grid; place-items: center; position: fixed; right: 18px; bottom: 82px; z-index: 30; width: 50px; height: 50px; border-radius: 50%; color: var(--color-on-primary); background: var(--color-primary); box-shadow: 0 7px 20px rgba(0,74,198,.24); }
    .open-doc .home-fab svg { width: 27px; height: 27px; }
    .open-doc .home-quick-menu { right: 16px; bottom: 139px; }
    .open-doc .app-header { gap: 6px; }
    .open-doc .app-header .save-status { flex: 0 0 100px; width: 100px; }
    .open-doc .document-quickbar { min-height: 37px; }
    .open-doc .document-quickbar .quickbar-title { display: none; }
    .open-doc .menubar [data-menu] { padding-inline: 10px; }
}
@media (max-width: 479px) {
    .open-doc .app-header .product span:not(.brand-mark) { display: none; }
    .open-doc .app-header .product .brand-mark { display: grid; }
    .open-doc .app-header .save-status { flex-basis: 72px; width: 72px; }
    .open-doc .app-header input[data-title] { min-width: 90px; max-width: 220px; }
    .open-doc .home-create-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .open-doc .document-quickbar { padding-inline: 5px; }
    .open-doc .document-quickbar button { padding-inline: 7px; font-size: 11px; }
}

/* Dialogs become accessible bottom sheets only in compact windows. */
@media (max-width: 719px) {
    .open-doc .modal-backdrop { align-items: end; justify-items: stretch; padding: 0; }
    .open-doc .dialog {
        width: 100%;
        max-height: min(85vh, 740px);
        border-radius: 20px 20px 0 0;
        padding: 22px 16px max(22px, env(safe-area-inset-bottom, 0px));
        border-bottom: 0;
    }
    .open-doc .fixed-document { grid-template-columns: 100px minmax(0,1fr); }
    .open-doc .fixed-sidebar { padding: 7px; }
    .open-doc .fixed-scroll { padding: 12px; }
    .open-doc .semantic-selection-menu {
        max-width: calc(100vw - 16px);
        flex-wrap: nowrap;
        overflow-x: auto;
    }
}
@media (max-width: 479px) {
    .open-doc .fixed-document { grid-template-columns: 80px minmax(0,1fr); }
    .open-doc .fixed-controls { overflow-x: auto; flex-wrap: nowrap; }
    .open-doc .fixed-controls input[type="search"] { min-width: 120px; }
}

/* Slide studio gives the stage priority as the window narrows. */
@media (max-width: 1199px) {
    .open-doc .fixed-document[data-slide-editor="true"] { grid-template-columns:132px minmax(0,1fr) 230px; }
    .open-doc .slide-inspector { padding:12px; }
    .open-doc .fixed-document[data-slide-editor="true"] .fixed-scroll { padding:16px; }
}
@media (max-width: 850px) {
    .open-doc .fixed-document[data-slide-editor="true"] { grid-template-columns:98px minmax(0,1fr); grid-template-rows:auto minmax(0,1fr) 185px; }
    .open-doc .fixed-document[data-slide-editor="true"] .slide-inspector { grid-column:2;grid-row:3;position:static;width:auto;max-height:185px;box-shadow:none;border-top:1px solid var(--color-border);border-left:0;padding:10px; }
    .open-doc .fixed-document[data-slide-editor="true"] .fixed-sidebar { grid-column:1; }
    .open-doc .fixed-document[data-slide-editor="true"] .fixed-scroll { grid-column:2; }
    .open-doc .slide-studio-toolbar { overflow-x:auto;flex-wrap:nowrap; }
}
@media (max-width: 600px) {
    .open-doc .fixed-document[data-slide-editor="true"] { grid-template-columns:76px minmax(0,1fr); }
    .open-doc .fixed-document[data-slide-editor="true"] .fixed-sidebar { padding:5px; }
    .open-doc .fixed-document[data-slide-editor="true"] .fixed-scroll { padding:8px; }
    .open-doc .slide-studio-toolbar button { padding:5px 9px; }
}


/* PDF annotation rail responsive layout */
@media(max-width:1100px){
  .open-doc .fixed-document[data-annotation-pane="true"]:not([data-slide-editor="true"]){
    grid-template-columns:145px minmax(0,1fr) 260px;
  }
}
@media(max-width:860px){
  .open-doc .fixed-document[data-annotation-pane="true"]:not([data-slide-editor="true"]){
    grid-template-columns:110px minmax(0,1fr);position:relative;
  }
  .open-doc .semantic-notes-rail{
    position:absolute;right:0;top:0;bottom:0;z-index:36;
    width:min(340px,calc(100% - 60px));box-shadow:-7px 0 24px rgba(0,0,0,.14);
  }
  .open-doc .fixed-sidebar{padding:6px}
}


/* Slide ribbon and Inspector responsive layout */
@media(max-width:1000px){
  .open-doc .fixed-document[data-slide-editor="true"]{
    grid-template-columns:130px minmax(0,1fr) minmax(220px,260px);
  }
  .open-doc .slide-inspector{padding:12px}
  .open-doc .slide-ribbon-group{flex-wrap:nowrap;overflow-x:auto;max-width:100%}
}
@media(max-width:720px){
  .open-doc .fixed-document[data-slide-editor="true"]{
    grid-template-columns:100px minmax(0,1fr);
  }
  .open-doc .fixed-document[data-slide-editor="true"] .slide-inspector{
    grid-column:2;grid-row:2;position:absolute;right:0;top:0;
    bottom:0;z-index:25;width:min(270px,55%);
    box-shadow:-5px 0 16px rgba(0,0,0,.12);
  }
}

/* Table builder and help adapt without introducing media queries in modules. */
@media(max-width:720px){
  .open-doc .table-dialog-dimensions{grid-template-columns:repeat(2,minmax(0,1fr))}
  .open-doc .table-preset-grid{grid-template-columns:1fr}
  .open-doc .dialog.dialog-table,.open-doc .dialog.dialog-help{
    width:100%;max-height:85vh
  }
}

/* Library sidebar yields to existing bottom navigation on small screens. */
@media(max-width:1110px){
  .open-doc .home{grid-template-columns:170px minmax(0,1fr)}
  .open-doc .home-side-nav{padding:20px 9px}
  .open-doc .home-side-nav button{font-size:12px;gap:8px;padding:9px}
}
@media(max-width:720px){
  .open-doc .home{display:block}
  .open-doc .home-side-nav{display:none}
  .open-doc .home-inner{width:calc(100% - 28px)}
}

@media(max-width:720px){
  .open-doc .dialog.dialog-equation{width:100%;max-height:85vh}
  .open-doc .equation-symbols{grid-template-columns:repeat(4,minmax(0,1fr))}
  .open-doc .equation-calc-actions{flex-wrap:wrap}
}

/* Visibility is authoritative over flex/grid component display declarations. */
.open-doc [hidden] {
    display: none !important;
}
.open-doc .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
}
.open-doc[data-home-view='true'] .toolbar,
.open-doc[data-home-view='true'] [data-document-body] {
    display: none;
}
